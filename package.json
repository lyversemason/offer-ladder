{
  "name": "offer-ladder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests scripts",
    "preview": "vite preview --port 10004",
    "test": "vitest run",
    "check": "tsc -b && oxlint src tests scripts && vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:live": "node scripts/screenshots-live.mjs",
    "db:start": "tsx scripts/build-functions.ts && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && tsx --import ./scripts/sql-files.mjs scripts/db-seed.ts",
    "db:report": "tsx --import ./scripts/sql-files.mjs scripts/db-report.ts",
    "db:report-functions": "tsx --import ./scripts/sql-files.mjs scripts/db-report-functions.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "dev:live": "tsx scripts/dev-live.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
